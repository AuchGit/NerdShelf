{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",

  "productName": "SupaManager",
  "version": "1.0.0",
  "identifier": "de.dndbehind.supamanager",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "SupaManager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/badges/*"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Supabase Management Desktop App",
    "longDescription": "Verwalte deine Supabase-Projekte, User, Bug Reports und Datenbanken."
  },

  "plugins": {
    "shell": {},
    "notification": {}
  }
}